{
  "name": "@salesreport/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SalesReport AI REST API (Express + Prisma).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "prisma migrate deploy && tsx watch --clear-screen=false src/index.ts",
    "build": "prisma generate && tsup",
    "start": "prisma migrate deploy && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "node dist/seed.js",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "sample-data": "tsx scripts/generate-sample-data.ts",
    "db:use-postgres": "node scripts/use-postgres.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@salesreport/shared": "1.0.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.17.2",
    "pino": "^9.12.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^5.1.0"
  }
}
