# ──────────────────────────────────────────────────────────────────────────────
#  SalesReport AI — environment configuration
#  Copy to `.env` (repo root) and fill in. `npm run setup` does this for you and
#  generates strong random secrets. NEVER commit your real .env.
# ──────────────────────────────────────────────────────────────────────────────

# --- Server -------------------------------------------------------------------
NODE_ENV=development            # development | production | test
PORT=4000                       # API port (in production it also serves the web app)
HOST=0.0.0.0
# Public URL users open in the browser. https:// enables Secure cookies + HSTS automatically.
APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (defaults to APP_URL's origin).
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (1 behind Nginx/Render/Railway), or "loopback".
TRUST_PROXY=0

# --- Database -----------------------------------------------------------------
# SQLite (default, path is relative to apps/server/prisma/):
DATABASE_URL=file:./dev.db
# PostgreSQL (run `npm run db:use-postgres -w @salesreport/server` first):
# DATABASE_URL=postgresql://user:password@localhost:5432/salesreport?schema=public

# --- Security (REQUIRED) ------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32-byte key for AES-256-GCM encryption of stored API keys. Generate: openssl rand -hex 32
# Changing it makes previously saved API keys unreadable (re-enter them in Settings → AI).
ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32-and-paste-64-hex-characters
ACCESS_TOKEN_TTL_SECONDS=900    # short-lived access token (15 min)
REFRESH_TOKEN_TTL_DAYS=7        # rotating refresh token in an httpOnly cookie
COOKIE_SECURE=auto              # auto (=true when APP_URL is https) | true | false
ALLOW_REGISTRATION=true         # false = only admins can add users
LOGIN_MAX_ATTEMPTS=5            # failed logins before lockout
LOGIN_LOCK_MINUTES=15           # lockout duration (doubles for each further failure, max 24h)

# --- AI / LLM -----------------------------------------------------------------
# openai | gemini | anthropic | none  (none, or a missing key → built-in rule-based summaries)
LLM_PROVIDER=openai
# Optional model override. Defaults: openai=gpt-4.1-mini, gemini=gemini-2.5-flash, anthropic=claude-haiku-4-5
LLM_MODEL=
LLM_TIMEOUT_MS=30000
OPENAI_API_KEY=                 # https://platform.openai.com/api-keys
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (OpenRouter, Azure proxy, Ollama…)
GEMINI_API_KEY=                 # https://aistudio.google.com/app/apikey
ANTHROPIC_API_KEY=              # https://console.anthropic.com/settings/keys

# --- Demo ---------------------------------------------------------------------
# true = seed demo data on start and WIPE + re-seed ALL data daily. Only for public demos!
DEMO_MODE=false
# true = seed the demo organization once on first start when the database is empty (no daily reset).
SEED_DEMO_DATA=false
DEMO_RESET_HOUR_UTC=0

# --- Misc ---------------------------------------------------------------------
# Exchange rates for the display currency (approximate). Live refresh from a free, key-less API every 12 h;
# falls back to the bundled table when unreachable. Set false for fully offline installs.
FX_LIVE_RATES=true
# FX_RATES_URL=https://open.er-api.com/v6/latest/USD

SERVE_WEB=true                  # serve apps/web/dist from the API (single-service deploy)
# WEB_DIST_PATH=/absolute/path/to/apps/web/dist
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
BODY_LIMIT=1mb                  # JSON body size limit
RATE_LIMIT_DISABLED=false
